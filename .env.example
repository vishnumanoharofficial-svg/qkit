# ============================================================
# qkit — Environment Variables
# Copy this file to .env.local and fill in real values
# ============================================================

# Supabase (required for database, auth and storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (required for payments)
RZP_KEY_ID=rzp_test_xxxxxxxxxxxx
RZP_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RZP_KEY_ID=rzp_test_xxxxxxxxxxxx

# OTP / SMS (MSG91 recommended for India)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-otp-template-id

# Maps (Mapbox)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=qkit

# Security
NEXTAUTH_SECRET=your-32-char-random-secret
